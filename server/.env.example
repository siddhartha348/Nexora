# ==============================================================================
# NEXORA Server — Environment Variables
# ==============================================================================
# Copy this to server/.env  (NEVER commit to version control)
# ==============================================================================

NODE_ENV=development
PORT=3001

# FastAPI backend base URL
FASTAPI_BASE_URL=http://127.0.0.1:8000

# JWT secret (must match FastAPI backend SECRET_KEY - minimum 32 chars)
SECRET_KEY=replace_with_at_least_32_char_cryptographically_secure_random_key

# Allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# External AI — kept server-side only, never in browser bundle
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

