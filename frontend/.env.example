# ==============================================================================
# NEXORA Brand Governance Platform — Frontend Environment Variables
# ==============================================================================
# Copy this file to .env and fill in values for your deployment.
# NEVER commit .env to version control.
#
# All VITE_ variables are compiled into the browser bundle.
# Do NOT put secrets here — secrets belong in /server/.env only.
# ==============================================================================

# ── Backend API ──────────────────────────────────────────────────────────────
# Base URL for the FastAPI backend (proxied via Vite in dev).
# In production, set this to your deployed API origin.
VITE_API_BASE_URL=http://localhost:8000

# ── Business / Legal Identity (optional — fields hidden when empty) ──────────
# See TODO_BUSINESS_DETAILS.md for the full list and instructions.
VITE_BUSINESS_LEGAL_NAME=
VITE_BUSINESS_TRADING_NAME=NEXORA
VITE_BUSINESS_ADDRESS=
VITE_BUSINESS_CONTACT_EMAIL=
VITE_BUSINESS_CONTACT_PHONE=
VITE_GRIEVANCE_OFFICER_NAME=
VITE_GRIEVANCE_OFFICER_EMAIL=
VITE_JURISDICTION=
VITE_GST_OR_REG_NUMBER=
VITE_LEGAL_LAST_UPDATED=2026-11-06

