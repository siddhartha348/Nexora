# ==============================================================================
# NEXORA Brand Governance Platform — Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME="NEXORA Brand Governance"
API_V1_PREFIX="/api/v1"
SECRET_KEY="replace-this-with-a-cryptographically-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS & Frontend Origin
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Connections
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="nexora_governance"
CHROMA_PERSIST_DIR="./data/chroma"

# Rate Limiting & Security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# External AI Provider (Optional in offline/mock mode)
GEMINI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_AI_PROVIDER="gemini"

